{
  "name": "booked-production-enquiries",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://bookednow.co.za,https://www.bookednow.co.za" },
  "ratelimits": [{ "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60} }],
  "observability": { "enabled": true }
}
